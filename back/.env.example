# Copia a .env.local (PostgreSQL local) o .env.supabase (Supabase) y rellena.
# El perfil se elige con: npm run start:local | start:supabase
# (por defecto: local, o la variable DB_PROFILE)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_NAME=campos_db
DB_SSL=false
PORT=3000
